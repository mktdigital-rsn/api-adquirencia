{
  "name": "api-adquirencia",
  "version": "1.0.0",
  "private": true,
  "description": "API de adquirencia G8 para consulta segura de estabelecimentos comerciais aprovados.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "deploy": "npm run credit:validate-wrangler && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "credit:migrate": "node scripts/migrate-credit.js",
    "credit:issue-key": "node scripts/issue-credit-key.js",
    "credit:validate-config": "node scripts/validate-credit-config.js",
    "credit:validate-wrangler": "node scripts/validate-wrangler-config.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.4.0"
  }
}
